        <mxCell id="p5" value="lee archivos&#10;con credencial propia" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0078D4;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;fontSize=11;fontColor=#0078D4;" edge="1" parent="1" source="e" target="c">
