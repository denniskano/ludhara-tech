        <mxCell id="p4" value="REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C48A1A;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;fontSize=11;fontColor=#C48A1A;" edge="1" parent="1" source="d" target="e">
          <mxGeometry relative="1" as="geometry"/>
