  <diagram id="demo-detalle" name="Detalle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="Detalle de la corrida · lo que existió y lo que no se llegó a publicar" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="24" y="16" width="1500" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="Nombres de esta corrida. La columna de la derecha separa el alta que sí se consultó de la integración que solo quedó en los scripts." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="24" y="48" width="1500" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="c1h" value="Confluent · env-3r253o · lkc-2ryr1m" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3D2E7C;strokeColor=#3D2E7C;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="24" y="86" width="500" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;Provider integration&lt;/b&gt; cspi-111q3&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;App c0b63658-19f2-4cb7-96cf-606e3b881cc4&lt;br&gt;Reader + Storage Blob Data Contributor&lt;/font&gt;&lt;hr&gt;&lt;b&gt;Datagen&lt;/b&gt; lcc-6k65o0j, luego en pausa&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;max.interval 5000 es el hueco máximo&lt;/font&gt;&lt;hr&gt;&lt;b&gt;Tópico&lt;/b&gt; rdv-demo-transactions&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Subject rdv-demo-transactions-value&lt;br&gt;Schema Registry en westus2&lt;/font&gt;&lt;hr&gt;&lt;b&gt;Tableflow&lt;/b&gt; fase RUNNING&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;DELTA, PORTABLE, LOG&lt;br&gt;DLQ rdv-demo-tableflow-dlq&lt;br&gt;retention_ms 7 días de snapshots&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C4D9A;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=12;spacingTop=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="24" y="130" width="500" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="c2h" value="Azure · rg-tableflow-rdv-demo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#0078D4;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="548" y="86" width="520" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;Cuenta&lt;/b&gt; sttfrdvb4f55447&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;HNS, Standard LRS, TLS 1.2&lt;br&gt;publicNetworkAccess Enabled&lt;/font&gt;&lt;hr&gt;&lt;b&gt;Container&lt;/b&gt; rdv-demo, vacío al habilitar&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Luego: 5 commits de _delta_log&lt;br&gt;y 2 Parquet&lt;/font&gt;&lt;hr&gt;&lt;b&gt;Ruta que asignó Tableflow&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;abfss://rdv-demo@sttfrdv…/&lt;br&gt;&amp;lt;seg&amp;gt;/&amp;lt;seg&amp;gt;/&amp;lt;org&amp;gt;/env-3r253o/&lt;br&gt;lkc-2ryr1m/v1/&amp;lt;uuid&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=12;spacingTop=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="548" y="130" width="520" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="c3h" value="Databricks · dbw-tableflow-rdv-demo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E85D04;strokeColor=#E85D04;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1092" y="86" width="554" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Cuenta&lt;/b&gt; tableflow-rdv&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;dennispaitan@outlook.com, la de az login&lt;br&gt;Metastore ya visible en Catalog&lt;/font&gt;&lt;hr&gt;&lt;b&gt;Access Connector&lt;/b&gt; ac-tableflow-rdv-demo&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Storage Blob Data Reader&lt;/font&gt;&lt;hr&gt;&lt;b&gt;cred_rdv_demo&lt;/b&gt; y &lt;b&gt;loc_rdv_demo&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Solo lectura, raíz del container&lt;/font&gt;&lt;hr&gt;&lt;b&gt;Tabla consultada&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;dbw_tableflow_rdv_demo.rdv.transactions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E85D04;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=12;spacingTop=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1092" y="130" width="554" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="okh" value="Alta que sí se ejecutó" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F6B4C;strokeColor=#0F6B4C;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="24" y="440" width="780" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="ok" value="&lt;b&gt;CREATE EXTERNAL TABLE&lt;/b&gt; en el SQL Editor, con el Serverless Starter Warehouse.&lt;br&gt;El LOCATION es la carpeta de Tableflow, no la raíz del container.&lt;br&gt;CREATE CATALOG demo falló: esta cuenta tiene Default Storage y el metastore no tiene storage root.&lt;br&gt;Se usó el catálogo que ya existía, dbw_tableflow_rdv_demo. El SELECT devolvió filas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF7;strokeColor=#0F6B4C;strokeWidth=1.5;fontSize=13;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="24" y="484" width="780" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="noh" value="Alta escrita en los scripts y no ejecutada" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8A6A2F;strokeColor=#8A6A2F;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="828" y="440" width="818" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="no" value="&lt;b&gt;./azure/databricks.sh&lt;/b&gt; dejaría el principal tableflow-rdv-sp, External data access y los permisos.&lt;br&gt;&lt;b&gt;./confluent/desplegar.sh --catalogo&lt;/b&gt; registraría tableflow-rdv-uc.&lt;br&gt;Tableflow crearía el schema &lt;b&gt;lkc-2ryr1m&lt;/b&gt; y su propia external table. No reutiliza rdv.transactions.&lt;br&gt;No se corrió: la demo se desaprovisionó antes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EE;strokeColor=#8A6A2F;strokeWidth=1.5;fontSize=13;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="828" y="484" width="818" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="ordh" value="Orden en que corrió, y cómo se apagó" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="24" y="634" width="1622" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="ord" value="1. ADLS y container vacío.  2. Provider integration.  3. Service principal y roles; 3 minutos.  4 y 5. Workspace Premium, Access Connector, credencial y external location.  6. Tópico, Datagen y Tableflow.  7. Pausa.  8. Archivos en el container, a los 5 minutos.  9. SELECT.&lt;br&gt;&lt;br&gt;&lt;b&gt;Apagado.&lt;/b&gt; Confluent borró conector, Tableflow, tópicos, subject, provider integration y API key. Azure borró tabla, schema, external location, credencial, el resource group y el service principal del tenant. Quedan la cuenta de Databricks y el metastore. El environment y el cluster no se tocan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#888888;fontSize=13;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="24" y="678" width="1622" height="120" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
