        </mxCell>
        <mxCell id="s" value="Red pública. Tableflow escribe un Delta en ADLS Gen2. Databricks lo lee con una external table registrada a mano. El SELECT devolvió filas." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#444444;" vertex="1" parent="1">
