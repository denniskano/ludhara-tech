<mxfile host="app.diagrams.net" agent="Cursor" version="24.7.0">
  <diagram id="temporal-cloud-azure-private-link" name="Private Link por namespace">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1970" pageHeight="1330" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Temporal Cloud on Azure — Private Link por namespace&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1200" height="30" as="geometry"/></mxCell>
<mxCell id="c4" value="Pre-release (invite-only): solo desarrollo y evaluación, sin SLA ni producción. Public Preview objetivo: noviembre 2026 · GA objetivo: Q1 2027. Regiones: centralus, australiaeast." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8A5A12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1500" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="Azure — suscripción BCP (región recomendada: la misma del namespace)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F5F9FD;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=40;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#0078D4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="930" height="650" as="geometry"/></mxCell>
<mxCell id="c7" value="VNet de aplicaciones (spoke)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#EEF2EF;strokeColor=#1F4E3D;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=40;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#1F4E3D;fontFamily=Helvetica;" vertex="1" parent="c5"><mxGeometry x="20" y="46" width="420" height="330" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Workers AKS — APOQ / NREM&lt;/b&gt;&lt;br&gt;Temporal SDK (Java) · mTLS o API key&lt;br&gt;Endpoint: &amp;lt;ns&amp;gt;.&amp;lt;account&amp;gt;.tmprl.cloud:7233" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E3D;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c7"><mxGeometry x="12" y="44" width="396" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;Clients / starters&lt;/b&gt;&lt;br&gt;Inician workflows, signals y queries" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E3D;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c7"><mxGeometry x="12" y="128" width="396" height="52" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;VM / pod de prueba&lt;/b&gt;&lt;br&gt;nslookup + temporal workflow list" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E3D;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c7"><mxGeometry x="12" y="198" width="396" height="52" as="geometry"/></mxCell>
<mxCell id="c15" value="Workers y Clients deben enrutar hacia la IP del Private Endpoint. Pueden estar en la misma VNet del PE o en otra VNet conectada por Peering, VPN o ExpressRoute." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="c7"><mxGeometry x="12" y="262" width="396" height="56" as="geometry"/></mxCell>
<mxCell id="c16" value="VNet del Private Endpoint (hub)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F0F4F8;strokeColor=#3D5A73;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=40;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#3D5A73;fontFamily=Helvetica;" vertex="1" parent="c5"><mxGeometry x="490" y="46" width="420" height="330" as="geometry"/></mxCell>
<mxCell id="c18" value="snet-privatelink" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#3D5A73;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=40;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#3D5A73;fontFamily=Helvetica;" vertex="1" parent="c16"><mxGeometry x="12" y="40" width="396" height="200" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;Private Endpoint · pe-temporal-centralus&lt;/b&gt;&lt;br&gt;IP privada: 10.1.2.3 (puerto 7233)&lt;br&gt;Resource: alias del Private Link Service&lt;br&gt;pl-…centralus.azure.privatelinkservice&lt;br&gt;Estado: Pending → Approved" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3D5A73;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c18"><mxGeometry x="10" y="36" width="376" height="100" as="geometry"/></mxCell>
<mxCell id="c23" value="&lt;b&gt;Network Security Group&lt;/b&gt;&lt;br&gt;Permitir TCP 7233 desde las VNets de workers" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3D5A73;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c18"><mxGeometry x="10" y="148" width="376" height="44" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;b&gt;Peering · VPN · ExpressRoute&lt;/b&gt;&lt;br&gt;Conecta spoke ↔ hub (u on-premises)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3D5A73;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=80;spacingRight=6;" vertex="1" parent="c16"><mxGeometry x="12" y="250" width="396" height="48" as="geometry"/></mxCell>
<mxCell id="c27" value="Private DNS zone" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F7F3EC;strokeColor=#8A5A12;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=40;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#8A5A12;fontFamily=Helvetica;" vertex="1" parent="c5"><mxGeometry x="20" y="400" width="890" height="230" as="geometry"/></mxCell>
<mxCell id="c29" value="&lt;b&gt;&amp;lt;account-id&amp;gt;.tmprl.cloud&lt;/b&gt;&lt;br&gt;A  apoq.&amp;lt;account-id&amp;gt;  → 10.1.2.3&lt;br&gt;A  nrem.&amp;lt;account-id&amp;gt;  → 10.1.2.3&lt;br&gt;Un registro A por namespace, todos hacia la IP del PE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A5A12;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c27"><mxGeometry x="12" y="40" width="430" height="100" as="geometry"/></mxCell>
<mxCell id="c31" value="&lt;b&gt;VNet links (registration-enabled = false)&lt;/b&gt;&lt;br&gt;Vincular la zona a toda VNet con Workers o Clients&lt;br&gt;Sin zona privada, el hostname resuelve por DNS público&lt;br&gt;y el tráfico sale por internet" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A5A12;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c27"><mxGeometry x="460" y="40" width="418" height="100" as="geometry"/></mxCell>
<mxCell id="c32" value="&lt;b&gt;Alternativa sin DNS privado&lt;/b&gt;&lt;br&gt;address = 10.1.2.3:7233 y tls_server_name (o server_name) = &amp;lt;ns&amp;gt;.&amp;lt;account-id&amp;gt;.tmprl.cloud. Se recomienda DNS privado: mantiene los hostnames estándar, evita el override de SNI y permite recrear el PE cambiando solo DNS." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="c27"><mxGeometry x="12" y="150" width="866" height="70" as="geometry"/></mxCell>
<mxCell id="c33" value="Temporal Cloud — región azure-centralus (cuenta &amp;lt;account-id&amp;gt;)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FAFAFA;strokeColor=#1A1A1A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=40;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1010" y="80" width="680" height="650" as="geometry"/></mxCell>
<mxCell id="c35" value="&lt;b&gt;Private Link Service&lt;/b&gt;&lt;br&gt;de Temporal Cloud&lt;br&gt;Aprueba el PE cuando existe una&lt;br&gt;Connectivity Rule con su resource ID" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c33"><mxGeometry x="12" y="140" width="290" height="100" as="geometry"/></mxCell>
<mxCell id="c37" value="Connectivity Rules (nivel cuenta)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F0F4F8;strokeColor=#3D5A73;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=40;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#3D5A73;fontFamily=Helvetica;" vertex="1" parent="c33"><mxGeometry x="316" y="40" width="352" height="224" as="geometry"/></mxCell>
<mxCell id="c39" value="&lt;b&gt;CR-PUB · pública&lt;/b&gt;&lt;br&gt;Permite internet. Solo durante la transición&lt;br&gt;(Workers que aún no usan Private Link)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8F2F2;strokeColor=#783C3C;fontSize=10;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c37"><mxGeometry x="10" y="38" width="332" height="70" as="geometry"/></mxCell>
<mxCell id="c41" value="&lt;b&gt;CR-AZ · privada&lt;/b&gt;&lt;br&gt;privateRule.azurePeResourceId =&lt;br&gt;/subscriptions/…/privateEndpoints/pe-temporal-centralus&lt;br&gt;privateRule.region = azure-centralus" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3D5A73;fontSize=10;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c37"><mxGeometry x="10" y="124" width="332" height="88" as="geometry"/></mxCell>
<mxCell id="c43" value="Namespaces — las reglas se adjuntan a cada namespace" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=40;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="c33"><mxGeometry x="12" y="282" width="656" height="354" as="geometry"/></mxCell>
<mxCell id="c44" value="&lt;b&gt;apoq.&amp;lt;account-id&amp;gt;  ·  reglas: [CR-AZ]&lt;/b&gt;&lt;br&gt;Solo acepta tráfico de ese Private Link.&lt;br&gt;Internet u otro Private Link: rechazado aun con credenciales válidas" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF2EF;strokeColor=#1F4E3D;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c43"><mxGeometry x="10" y="40" width="636" height="76" as="geometry"/></mxCell>
<mxCell id="c46" value="&lt;b&gt;nrem.&amp;lt;account-id&amp;gt;  ·  reglas: [CR-AZ] + [CR-PUB]&lt;/b&gt;&lt;br&gt;Acepta tráfico autenticado desde Private Link e internet.&lt;br&gt;Migración: detach de CR-PUB cuando todos los Workers usen Private Link" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F3EC;strokeColor=#8A5A12;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c43"><mxGeometry x="10" y="132" width="636" height="76" as="geometry"/></mxCell>
<mxCell id="c48" value="&lt;b&gt;dev.&amp;lt;account-id&amp;gt;  ·  sin reglas (default)&lt;/b&gt;&lt;br&gt;No bloquea tráfico entrante: sirve toda solicitud autenticada" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#666666;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c43"><mxGeometry x="10" y="224" width="636" height="60" as="geometry"/></mxCell>
<mxCell id="c50" value="Muchos a muchos: un PE accede a cualquier namespace de la región; un namespace acepta varios PE. HA multi-región aún no disponible en Azure." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="c43"><mxGeometry x="10" y="296" width="636" height="40" as="geometry"/></mxCell>
<mxCell id="c51" value="&lt;b&gt;Internet público&lt;/b&gt;&lt;br&gt;Worker o client fuera&lt;br&gt;de la red privada" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8F2F2;strokeColor=#783C3C;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1760" y="440" width="190" height="76" as="geometry"/></mxCell>
<mxCell id="c52" value="Administración (Platform / PEVE)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=40;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="1660" height="110" as="geometry"/></mxCell>
<mxCell id="c53" value="&lt;b&gt;Azure portal / Azure CLI&lt;/b&gt;&lt;br&gt;az network private-endpoint · private-dns  —  pasos 1, 2, 4, 5" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c52"><mxGeometry x="12" y="40" width="400" height="56" as="geometry"/></mxCell>
<mxCell id="c55" value="&lt;b&gt;temporal cloud CLI&lt;/b&gt;&lt;br&gt;connectivity private create · namespace connectivity attach  —  pasos 3, 6, 7" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c52"><mxGeometry x="424" y="40" width="470" height="56" as="geometry"/></mxCell>
<mxCell id="c57" value="&lt;b&gt;Cloud Ops API — saas-api.tmprl.cloud&lt;/b&gt;&lt;br&gt;HTTP / gRPC · Bearer API key  —  pasos 3, 6" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c52"><mxGeometry x="906" y="40" width="380" height="56" as="geometry"/></mxCell>
<mxCell id="c59" value="&lt;b&gt;Terraform provider&lt;/b&gt;&lt;br&gt;Temporal Cloud (julio 2026)  —  pasos 3, 6" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;" vertex="1" parent="c52"><mxGeometry x="1298" y="40" width="350" height="56" as="geometry"/></mxCell>
<mxCell id="c71" value="Pasos de configuración" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=40;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#0078D4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="890" width="1020" height="420" as="geometry"/></mxCell>
<mxCell id="c72" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="c71"><mxGeometry x="14" y="38" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="c73" value="Crear el Private Endpoint en la VNet, con “resource alias” = Private Link Service alias de la región del namespace (centralus o australiaeast). El PE puede estar en otra región, pero se recomienda la misma." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="c71"><mxGeometry x="48" y="36" width="956" height="52" as="geometry"/></mxCell>
<mxCell id="c74" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="c71"><mxGeometry x="14" y="92" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="c75" value="Verificar Provisioning State = Succeeded, Connection status = Pending, Awaiting Approval. Copiar el resource ID del PE (az network private-endpoint show --query id)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="c71"><mxGeometry x="48" y="90" width="956" height="52" as="geometry"/></mxCell>
<mxCell id="c76" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="c71"><mxGeometry x="14" y="146" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="c77" value="Crear la Connectivity Rule privada dentro de las 24 h (si no, el PE se rechaza y hay que recrearlo): temporal cloud connectivity private create --azure-pe-resource-id … --region azure-centralus. Temporal aprueba el PE. Guardar el connectivityRuleId." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="c71"><mxGeometry x="48" y="144" width="956" height="52" as="geometry"/></mxCell>
<mxCell id="c78" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="c71"><mxGeometry x="14" y="200" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="c79" value="Obtener la IP privada del PE (customDnsConfigs[0].ipAddresses[0])." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="c71"><mxGeometry x="48" y="198" width="956" height="52" as="geometry"/></mxCell>
<mxCell id="c80" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="c71"><mxGeometry x="14" y="254" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="c81" value="Crear la Private DNS zone &amp;lt;account-id&amp;gt;.tmprl.cloud, un registro A por namespace hacia la IP del PE y vincularla a las VNets de Workers (registration-enabled false). Verificar con nslookup." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="c71"><mxGeometry x="48" y="252" width="956" height="52" as="geometry"/></mxCell>
<mxCell id="c82" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="c71"><mxGeometry x="14" y="308" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="c83" value="Adjuntar la regla a cada namespace: temporal cloud namespace connectivity attach --namespace … --connectivity-rule-id …. Si hay Workers por internet, adjuntar también la regla pública, migrar y luego detach." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="c71"><mxGeometry x="48" y="306" width="956" height="52" as="geometry"/></mxCell>
<mxCell id="c84" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="c71"><mxGeometry x="14" y="362" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="c85" value="Probar: desde la VNet, temporal workflow list --address &amp;lt;ns&amp;gt;.&amp;lt;account-id&amp;gt;.tmprl.cloud:7233 responde; desde fuera falla con “Request unauthorized”." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="c71"><mxGeometry x="48" y="360" width="956" height="52" as="geometry"/></mxCell>
<mxCell id="c86" value="Comportamiento de las reglas y advertencias" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#783C3C;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=40;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#783C3C;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="890" width="620" height="420" as="geometry"/></mxCell>
<mxCell id="c87" value="&lt;b&gt;Reglas por namespace&lt;/b&gt;&lt;br&gt;• Sin reglas: no bloquea tráfico; sirve toda solicitud autenticada.&lt;br&gt;• Solo reglas privadas: únicamente desde esos Private Link.&lt;br&gt;• Privadas + pública: Private Link e internet.&lt;br&gt;&lt;br&gt;&lt;b&gt;Advertencias&lt;/b&gt;&lt;br&gt;• Adjuntar solo la regla privada corta el tráfico vivo por internet.&lt;br&gt;• La API UpdateNamespace es declarativa: enviar el spec completo con resourceVersion; un campo omitido se borra.&lt;br&gt;• En la API el namespace va sin “.tmprl.cloud” (ej.: payments.abcde).&lt;br&gt;• La API key solo se usa al crear la regla; deshabilitarla no afecta la regla.&lt;br&gt;• tcld no está soportado en Azure: usar temporal cloud CLI, Cloud Ops API o Terraform.&lt;br&gt;• La guía muestra dos alias distintos para centralus: confirmar con Temporal antes de crear el PE.&lt;br&gt;&lt;br&gt;&lt;b&gt;Troubleshooting: el PE sigue en Pending&lt;/b&gt;&lt;br&gt;• No existe una Connectivity Rule con ese resource ID (listar reglas: temporal cloud connectivity list).&lt;br&gt;• La regla se creó con otro resource ID: falla con “private endpoint connection not found”.&lt;br&gt;• El PE apunta a un alias de otra región que la del namespace: mismo error.&lt;br&gt;• Pasaron más de 24 h sin regla: el PE se rechaza y hay que recrearlo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="c86"><mxGeometry x="14" y="36" width="592" height="376" as="geometry"/></mxCell>
<mxCell id="c61" value="DNS: &amp;lt;ns&amp;gt;.&amp;lt;account-id&amp;gt;.tmprl.cloud → 10.1.2.3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#8A5A12;strokeWidth=2;dashed=1;fontSize=10;fontColor=#8A5A12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.53;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
