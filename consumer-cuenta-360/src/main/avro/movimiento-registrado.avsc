{
  "type": "record",
  "name": "MovimientoRegistrado",
  "namespace": "tech.ludhara.cuenta360.eventos",
  "fields": [
    { "name": "eventoId", "type": "string" },
    { "name": "movimientoId", "type": "string" },
    { "name": "cuentaId", "type": "string" },
    { "name": "tipo", "type": { "type": "enum", "name": "TipoMovimiento", "symbols": ["DEBITO", "CREDITO"] } },
    { "name": "montoCentavos", "type": "long" },
    { "name": "moneda", "type": "string" },
    { "name": "descripcion", "type": ["null", "string"], "default": null },
    { "name": "ocurridoEn", "type": { "type": "long", "logicalType": "timestamp-millis" } }
  ]
}
