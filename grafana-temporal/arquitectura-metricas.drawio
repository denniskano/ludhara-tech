        </mxCell>
        <mxCell id="note" value="Los workers en AKS y el runtime de Temporal Cloud no cambian. Cambia cómo Grafana autentica y consume las series. v0 se apaga el 5 oct 2026." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#444444;" vertex="1" parent="1">
